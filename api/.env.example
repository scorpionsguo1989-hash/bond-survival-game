# 城投生存游戏后端环境变量样板
# 部署时 cp .env.example .env 并按实际填写
# .env 已在 .gitignore 中, 不会进 git

# Node.js 监听端口
# 本地开发: 3001 (避免和 gaozhai-bond next dev 的 3000 冲突, 配合 main 站 dev rewrites)
# 生产部署: 3000 (阿里云 nginx /api/ proxy_pass 到此)
PORT=3001

# SQLite 数据库路径
# 本地开发: ./leaderboard.db (相对当前工作目录, 即 api/leaderboard.db)
# 生产部署: /opt/bond-game-api/leaderboard.db (绝对路径, 部署 rsync 时不被覆盖)
DB_PATH=./leaderboard.db

# CORS 允许的 origin (逗号分隔, * 表示允许全部)
# 本地开发: http://localhost:3000,http://localhost:8080
# 生产部署: https://gaozhai.cn (同源不需要 CORS, 但 nginx 转发时浏览器仍会带 Origin)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# DeepSeek API Key (用于游戏 AI portrait/coaching, 可选)
# 不配置时游戏走 fallback 文案, 不影响核心功能
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

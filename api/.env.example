# 服务端环境变量示例
# 用法：复制为 .env 后填实际值，再用 dotenv 或 PM2 ecosystem 注入
# （没装 dotenv 的话，PM2 启动时通过 ecosystem.config.cjs 的 env 字段直接注入也行）

# 监听端口（默认 3000）
PORT=3000

# DeepSeek API key
# 申请：https://platform.deepseek.com/api_keys
# 价格：deepseek-chat ¥1/百万输入 tokens，¥2/百万输出 tokens
# 单次画像 ~500 token，成本约 ¥0.001/次；不配置则自动走模板兜底
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek 接口地址（默认即可，国内访问无需代理）
DEEPSEEK_URL=https://api.deepseek.com/v1/chat/completions

# 模型名（默认 deepseek-chat；如要换 deepseek-reasoner 可改这里）
DEEPSEEK_MODEL=deepseek-chat

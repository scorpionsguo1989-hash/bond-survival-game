              "score.liquidity": 2
            }
          },
          {
            "label": "逆势拉久期博利率回落",
            "effects": {
              "duration": 0.6,
              "redemptionPressure": 5,
              "score.costControl": 2
            }
          }
        ]
      }
    }
  },
  {
